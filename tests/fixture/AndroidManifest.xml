<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.fixture">

    <!-- API 36 (Android 16) pinned to SDK extension level 17: this is what the installed
         android-36 platform package provides (AndroidVersion.ExtensionLevel=17) and what a
         device reporting "build.version.extensions.b = 17" supports. -->
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36">
        <extension-sdk android:sdkVersion="36" android:minExtensionVersion="17" />
    </uses-sdk>

    <permission android:name="com.example.permission.HW_SIGNATURE"
        android:protectionLevel="signature" />

    <application android:label="joern-mcp fixture">

        <!-- TEST CASE 7: permission-gated receiver (signature-level permission) -->
        <receiver
            android:name=".GatedReceiver"
            android:exported="true"
            android:permission="com.example.permission.HW_SIGNATURE">
            <intent-filter>
                <action android:name="com.example.ACTION_GATED" />
            </intent-filter>
        </receiver>

        <!-- TEST CASE 2b: anonymous inner class carries the call -->
        <receiver android:name=".SilentInstallReceiver" android:exported="false" />

        <!-- TEST CASE 1/2/3: custom base receiver + delegation chain -->
        <receiver android:name=".AccountReceiver" android:exported="false" />

    </application>
</manifest>
